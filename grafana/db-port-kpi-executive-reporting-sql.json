          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana-postgresql-datasource"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH target_kpi AS (\n  SELECT\n    d.target_name,\n    sum(d.up_probes)::numeric / nullif(sum(d.probes), 0) * 100 AS availability_pct\n  FROM monitoring.db_port_blackbox_daily_kpi d\n  JOIN monitoring.db_port_blackbox_targets t ON t.target_name = d.target_name\n  WHERE NOT t.monitoring_excluded\n    AND d.period_start BETWEEN $__timeFrom()::date AND $__timeTo()::date\n    AND ('$environment' = '%' OR d.environment = '$environment')\n    AND ('$db_type' = '%' OR d.db_type = '$db_type')\n  GROUP BY d.target_name\n)\nSELECT\n  row_number() OVER (ORDER BY k.availability_pct, k.target_name) AS \"#\",\n  s.host AS \"Hostname\",\n  s.ip_address AS \"IP Address\",\n  s.port AS \"Port\",\n  s.db_type AS \"Type\",\n  round(k.availability_pct, 2)::double precision AS \"Availability (Selected Range)\",\n  (ARRAY['DOWN', 'UP'])[s.probe_success::int + 1] AS \"Current\"\nFROM target_kpi k\nJOIN monitoring.probe_current_status s ON s.host = k.target_name\nORDER BY k.availability_pct, k.target_name\nLIMIT 6;",
          "refId": "A"
        }
      ]
