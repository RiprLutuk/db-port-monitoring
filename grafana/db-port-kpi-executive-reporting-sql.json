          "rawQuery": true,
          "rawSql": "SELECT probe_success::int AS value\nFROM monitoring.probe_current_status\nWHERE NOT monitoring_excluded\n  AND host = ${target:sqlstring}\n  AND ('$environment' = '%' OR environment = '$environment')\n  AND ('$db_type' = '%' OR db_type = '$db_type')\n  AND ('$status' = '%' OR probe_success::text = '$status')\nORDER BY checked_at DESC\nLIMIT 1;",
