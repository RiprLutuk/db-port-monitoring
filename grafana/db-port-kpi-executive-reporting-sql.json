      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana-postgresql-datasource"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH target_kpi AS (\n  SELECT\n    d.target_name,\n    sum(d.up_probes)::numeric / nullif(sum(d.probes), 0) * 100 AS availability_pct\n  FROM monitoring.db_port_blackbox_daily_kpi d\n  JOIN monitoring.db_port_blackbox_targets t ON t.target_name = d.target_name\n  WHERE NOT t.monitoring_excluded\n    AND d.period_start BETWEEN $__timeFrom()::date AND $__timeTo()::date\n    AND ('$environment' = '%' OR d.environment = '$environment')\n    AND ('$db_type' = '%' OR d.db_type = '$db_type')\n  GROUP BY d.target_name\n)\nSELECT coalesce(round(avg(availability_pct), 2), 0)::double precision AS value\nFROM target_kpi;",
          "refId": "A"
        }
      ],
      "description": "Equal-weight average target availability for the dashboard time range."
    },
